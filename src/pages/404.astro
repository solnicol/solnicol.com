---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="404" description="This sheet does not exist in the archive.">
  <article class="project-page">
    <header class="project-hero">
      <p class="project-label">Error / 404</p>
      <h1>Sheet Not Found</h1>
      <p class="project-thesis">This drawing does not exist in the archive.</p>
      <div class="project-links">
        <a href="/">Return to index</a>
      </div>
    </header>
  </article>
</SiteLayout>
