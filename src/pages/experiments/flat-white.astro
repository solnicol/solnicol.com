---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import FlatWhiteExperiment from "../../components/flat-white/FlatWhiteExperiment.tsx";

const title = "Flat White | Sol Nicol";
const description =
  "Stir a rosetta into folds and watch the surface settle";
const canonical = new URL("/experiments/flat-white/", Astro.site);
const ogImage = new URL("/og-flat-white.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#14100d" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="focus-mark" href="/" aria-label="Sol Nicol — home">
      <span>&gt;_S01</span>
      <span>NIC01</span>
    </a>

    <main class="essay">
      <header class="essay-head">
        <p class="essay-kicker">Mixing</p>
        <h1>Flat White</h1>
        <p class="essay-sub">A small model of mixing</p>
        <p class="essay-intro">
          Stir the rosetta into folds, then watch the surface settle
        </p>
      </header>

      <noscript>
        <p class="noscript">
          This interactive surface needs JavaScript to run
          <a href="/projects/flat-white/">Read the notes</a> instead
        </p>
      </noscript>

      <FlatWhiteExperiment client:only="react" />

      <section class="essay-body">
        <p>
          Each leaf is a boundary between milk and coffee
          Stirring pulls those boundaries into finer folds
          The rosetta loses its shape, but the surface briefly gains structure
        </p>
        <p class="essay-note">
          The curve follows that middle
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    background:
      radial-gradient(120% 90% at 50% 0%, oklch(0.22 0.03 55) 0%, oklch(0.16 0.02 50) 45%, oklch(0.13 0.015 48) 100%);
    color: oklch(0.93 0.02 82);
    font-family: "Geist Variable", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: center;
  }

  .focus-mark {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    gap: 0.05rem;
    font-family: "Geist Mono Variable", monospace;
    font-size: 15px;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    color: oklch(0.72 0.03 70);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .focus-mark:hover {
    color: oklch(0.93 0.02 82);
  }

  .focus-mark:focus-visible {
    color: oklch(0.93 0.02 82);
    outline: 1px solid oklch(0.93 0.02 82 / 0.55);
    outline-offset: 0.35rem;
    border-radius: 0.2rem;
  }

  .essay {
    width: min(40rem, 100%);
    margin-top: clamp(3rem, 8vh, 5rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .essay-head {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .essay-kicker {
    font-family: "Geist Mono Variable", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: oklch(0.72 0.03 70);
  }

  .essay-head h1 {
    font-size: clamp(2.8rem, 8vw, 4.2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 0.98;
    color: oklch(0.96 0.02 85);
  }

  .essay-sub {
    font-size: clamp(1.2rem, 3.5vw, 1.5rem);
    line-height: 1.35;
    color: oklch(0.88 0.025 80);
    max-width: 34ch;
  }

  .essay-intro {
    font-family: "Geist Mono Variable", monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    color: oklch(0.78 0.03 72);
    max-width: 52ch;
  }

  .essay-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid oklch(0.93 0.02 82 / 0.14);
    padding-top: 1.75rem;
  }

  .essay-body p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: oklch(0.86 0.025 78);
    max-width: 60ch;
  }

  .essay-note {
    font-size: 0.92rem;
    color: oklch(0.74 0.03 70);
  }

  .essay-coda {
    font-size: 1.05rem;
    line-height: 1.5;
    color: oklch(0.9 0.025 80);
    margin-top: 0.5rem;
  }

  .noscript {
    max-width: 34rem;
    font-family: "Geist Mono Variable", monospace;
    font-size: 13px;
    line-height: 1.7;
    text-align: center;
    color: oklch(0.78 0.03 72);
  }

  .noscript a,
  .essay a {
    color: oklch(0.96 0.02 85);
  }
</style>
