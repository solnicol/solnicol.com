---
import "@fontsource-variable/geist-mono";
import TemperamentClock from "../../components/temperament-clock/TemperamentClock.jsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Temperament Clock | Sol Nicol</title>
    <meta
      name="description"
      content="A clock whose hours are the circle of fifths. Twelve pure fifths overshoot seven octaves — hear and see the Pythagorean comma."
    />
    <link rel="canonical" href={new URL("/experiments/temperament-clock/", Astro.site)} />
    <meta name="theme-color" content="#0e0e0f" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="focus-mark" href="/" aria-label="Sol Nicol — home">
      <span>&gt;_S01</span>
      <span>NIC01</span>
    </a>
    <noscript>
      <p class="noscript">
        The Temperament Clock is an interactive audio instrument and needs
        JavaScript to run. <a href="/projects/temperament-clock/">Read the notes</a> instead.
      </p>
    </noscript>
    <TemperamentClock client:only="react" />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: oklch(0.164 0.002 286.2);
  }

  .focus-mark {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    gap: 0.05rem;
    font-family: "Geist Mono Variable", monospace;
    font-size: 15px;
    letter-spacing: 0;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    /* Identity, not signal — the mark stays ink, never brass. */
    color: oklch(0.7 0.006 95.2);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .focus-mark:hover,
  .focus-mark:focus-visible {
    color: oklch(0.925 0.007 88.6);
    outline: none;
  }

  @media (max-width: 480px) {
    .focus-mark {
      font-size: 13px;
    }
  }

  .noscript {
    max-width: 30rem;
    margin: 6rem auto 0;
    padding: 0 1.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.7;
    text-align: center;
    color: oklch(0.7 0.006 95.2);
  }

  .noscript a {
    color: oklch(0.925 0.007 88.6);
  }
</style>
