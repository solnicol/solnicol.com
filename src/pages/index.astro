---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const projectSlug = (id: string) => id.replace(/\.mdx?$/, "");
---

<SiteLayout title="Home">
  <div class="hero">
    <div class="hero-orbit" aria-hidden="true"></div>
    <h1 aria-label="Sol Nicol">
      <span class="hero-line" aria-hidden="true">
        <span>S</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
      </span>
      <span class="hero-line" aria-hidden="true">
        <span>NIC</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
      </span>
    </h1>
    <p class="tagline">Visual experiments in design and code.</p>
  </div>

  <h2 class="section-label" id="experiments">Section / Experiments</h2>

  <div class="experiment-list">
    {projects.map((project, i) => (
      <div class="experiment">
        <div class="experiment-signal" aria-hidden="true"></div>
        <div class="experiment-main">
          <div class="experiment-kicker">
            <span class="experiment-index">{String(i + 1).padStart(2, "0")}</span>
            <span>{project.data.year}</span>
            <span class="experiment-tags">{project.data.tags.join(" / ")}</span>
          </div>
          <a class="experiment-title" href={`/projects/${projectSlug(project.id)}/`}>
            <strong>{project.data.title}</strong>
          </a>
          <p>{project.data.thesis}</p>
          <div class="experiment-links">
            <a href={`/projects/${projectSlug(project.id)}/`}>Open <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h2 class="section-label" id="contact">Section / Contact</h2>

  <ul class="links">
    <li><a href="mailto:sol@solnicol.com">sol@solnicol.com</a></li>
    <li><a href="https://www.linkedin.com/in/solnicol/">LinkedIn</a></li>
    <li><a href="https://github.com/solnicol">GitHub</a></li>
    <li><a href="https://x.com/SolNicol_">X</a></li>
  </ul>
</SiteLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--border-soft);
    border-left: 1px solid var(--border-soft);
    padding-bottom: 1.6rem;
    padding-left: clamp(1rem, 2vw, 1.35rem);
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    top: 0;
    left: -0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
    content: "";
    opacity: 0.78;
  }

  .hero::after {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1.35rem;
    background-image: linear-gradient(90deg, var(--border-strong), transparent 62%);
    content: "";
    opacity: 0.72;
    transform: scaleX(0.42);
    transform-origin: left;
  }

  .hero-orbit {
    position: absolute;
    top: -8.5rem;
    right: -8rem;
    z-index: -1;
    width: 28rem;
    aspect-ratio: 1;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    background:
      repeating-conic-gradient(from 18deg, oklch(1 0 0 / 0.08) 0deg 1deg, transparent 1deg 7deg),
      radial-gradient(circle, transparent 0 43%, var(--border-soft) 43.2% 43.6%, transparent 43.8%);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero-orbit::before,
  .hero-orbit::after {
    position: absolute;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    content: "";
    inset: 18%;
  }

  .hero-orbit::after {
    inset: 34%;
    border-style: dashed;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: 6.2rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 0.92;
    margin-bottom: 1.25rem;
  }

  .hero-line {
    display: inline-flex;
    align-items: baseline;
  }

  .glyph-swap {
    display: inline-grid;
    min-width: 1.19em;
    color: inherit;
    perspective: 0.9em;
  }

  .glyph-name,
  .glyph-code {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    transform-origin: center 58%;
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    will-change: opacity, transform;
  }

  .glyph-code {
    /* Signal at display size renders as leaf — the material, not the
       flat tone. color stands in where background-clip is unsupported. */
    color: var(--signal);
    background: linear-gradient(
      135deg,
      oklch(55% 0.12 72) 0%,
      oklch(75% 0.14 82) 25%,
      oklch(92% 0.08 88) 50%,
      oklch(70% 0.15 80) 75%,
      oklch(48% 0.13 70) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: rotateX(74deg) translateY(0.035em);
  }

  @media (hover: hover) {
    .hero h1:hover .glyph-name {
      opacity: 0;
      transform: rotateX(-74deg) translateY(-0.035em);
    }

    .hero h1:hover .glyph-code {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
  }

  .tagline {
    font-size: 1.42rem;
    line-height: 1.45;
    color: var(--fg-1);
    max-width: 60ch;
  }

  .experiment-list {
    border-top: 1px solid var(--border-soft);
  }

  .experiment {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.65rem 1rem 1.9rem 0;
    border-bottom: 1px solid var(--border-soft);
    border-left: 1px solid transparent;
    transition:
      background-color var(--duration-med) var(--ease-out),
      border-color var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .experiment::before {
    position: absolute;
    top: -1px;
    right: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
    content: "";
    opacity: 0.64;
    transition: opacity var(--duration-med) var(--ease-out);
  }

  .experiment::after {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  @media (hover: hover) {
    .experiment:hover {
      border-color: var(--border-strong);
      background: oklch(1 0 0 / 0.035);
      transform: translateY(-2px);
    }

    .experiment:hover::after {
      opacity: 0.72;
      transform: scaleX(1);
    }

    .experiment:hover::before {
      opacity: 1;
    }
  }

  .experiment:focus-within {
    border-color: var(--border-strong);
    background: oklch(1 0 0 / 0.035);
    transform: translateY(-2px);
  }

  .experiment:focus-within::after {
    opacity: 0.72;
    transform: scaleX(1);
  }

  .experiment:focus-within::before {
    opacity: 1;
  }

  .experiment-signal {
    position: relative;
    align-self: start;
    width: 4.6rem;
    aspect-ratio: 1;
    margin-top: 0.1rem;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    background:
      linear-gradient(90deg, transparent calc(50% - 0.5px), var(--border-strong) 50%, transparent calc(50% + 0.5px)),
      linear-gradient(0deg, transparent calc(50% - 0.5px), var(--border-strong) 50%, transparent calc(50% + 0.5px)),
      radial-gradient(circle at center, transparent 0 21%, var(--border-soft) 21.5% 22.5%, transparent 23% 42%, var(--border-soft) 42.5% 43.5%, transparent 44%);
    transition:
      border-color var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .experiment-signal::before,
  .experiment-signal::after {
    position: absolute;
    content: "";
  }

  .experiment-signal::before {
    top: 50%;
    left: 50%;
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid var(--accent);
    transform: translate(-50%, -50%);
  }

  .experiment-signal::after {
    inset: 15%;
    border: 1px dashed var(--border-soft);
    border-radius: 50%;
  }

  @media (hover: hover) {
    .experiment:hover .experiment-signal {
      border-color: var(--accent);
      transform: rotate(18deg);
    }
  }

  .experiment:focus-within .experiment-signal {
    border-color: var(--accent);
    transform: rotate(18deg);
  }

  .experiment-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .experiment-index {
    color: var(--accent);
  }

  .experiment-tags {
    color: var(--fg-3);
    letter-spacing: 0.18em;
  }

  .experiment-main {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .experiment-title {
    width: fit-content;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card so the hover lift matches
     what is actually clickable; the buttons below re-raise themselves. */
  .experiment-title::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .experiment-main strong {
    font-size: 2.15rem;
    font-weight: 550;
    letter-spacing: 0;
    line-height: 1.1;
    color: var(--fg-0);
  }

  .experiment-main p {
    color: var(--fg-1);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 52ch;
  }

  .experiment-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-1);
  }

  .experiment-links a {
    position: relative;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    border: 1px solid var(--border-strong);
    padding: 0.42rem 0.58rem;
    text-decoration: none;
  }

  .experiment-links a:hover,
  .experiment-links a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .experiment-links span {
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .experiment-links a:hover span,
  .experiment-links a:focus-visible span {
    transform: translate(2px, -1px);
  }

  @media (max-width: 900px) {
    .hero h1 {
      font-size: 4.6rem;
    }

    .hero-orbit {
      right: -13rem;
    }
  }

  @media (max-width: 720px) {
    .hero h1 {
      font-size: 3.3rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .hero-orbit {
      top: -6rem;
      right: -15rem;
      width: 24rem;
    }

    .experiment {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .experiment-signal {
      width: 3.5rem;
    }

    .experiment-main strong {
      font-size: 1.75rem;
    }

    .experiment-links a {
      padding: 0.7rem 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-name,
    .glyph-code {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
