---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const projectSlug = (id: string) => id.replace(/\.mdx?$/, "");
---

<SiteLayout title="Home">
  <div class="hero">
    <div class="hero-orbit" aria-hidden="true">
      <span></span>
    </div>
    <h1>
      <span class="hero-line">Sol</span>
      <span class="hero-line">Nicol</span>
    </h1>
    <p class="tagline">Visual experiments in design and code.</p>
  </div>

  <h3 id="experiments">Experiments</h3>

  <div class="experiment-list">
    {projects.map((project, i) => (
      <div class="experiment">
        <div class="experiment-signal" aria-hidden="true">
          <span></span>
        </div>
        <div class="experiment-main">
          <div class="experiment-kicker">
            <span class="experiment-index">{String(i + 1).padStart(2, "0")}</span>
            <span>{project.data.year}</span>
          </div>
          <a class="experiment-title" href={`/projects/${projectSlug(project.id)}/`}>
            <strong>{project.data.label}</strong>
          </a>
          <p>{project.data.thesis}</p>
          <div class="experiment-links">
            {project.data.liveUrl && <a href={project.data.liveUrl}>Enter <span aria-hidden="true">↗</span></a>}
            <a href={`/projects/${projectSlug(project.id)}/`}>Read <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h3 id="contact">Contact</h3>

  <ul class="links">
    <li><a href="mailto:sol@solnicol.com">sol@solnicol.com</a></li>
    <li><a href="https://www.linkedin.com/in/solnicol/">LinkedIn</a></li>
    <li><a href="https://github.com/solnicol">GitHub</a></li>
  </ul>
</SiteLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.6rem;
    overflow: hidden;
  }

  .hero::after {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1.35rem;
    background-image: linear-gradient(90deg, transparent, var(--accent), transparent);
    content: "";
    opacity: 0.28;
    transform: scaleX(0.36);
    transform-origin: left;
  }

  .hero-orbit {
    position: absolute;
    top: -8.5rem;
    right: -8rem;
    z-index: -1;
    width: 28rem;
    aspect-ratio: 1;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    background:
      repeating-conic-gradient(from 18deg, oklch(1 0 0 / 0.08) 0deg 1deg, transparent 1deg 7deg),
      radial-gradient(circle, transparent 0 43%, var(--border-soft) 43.2% 43.6%, transparent 43.8%);
    opacity: 0.5;
    pointer-events: none;
  }

  .hero-orbit::before,
  .hero-orbit::after,
  .hero-orbit span {
    position: absolute;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    content: "";
    inset: 18%;
  }

  .hero-orbit::after {
    inset: 34%;
    border-style: dashed;
  }

  .hero-orbit span {
    top: 50%;
    right: auto;
    bottom: auto;
    left: 8%;
    width: 0.6rem;
    height: 0.6rem;
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    font-size: 6.2rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 0.92;
    margin-bottom: 1.25rem;
  }

  .tagline {
    font-size: 1.42rem;
    line-height: 1.45;
    color: var(--fg-1);
    max-width: 60ch;
  }

  .experiment-list {
    border-top: 1px solid var(--border-soft);
  }

  .experiment {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.65rem 0 1.9rem;
    border-bottom: 1px solid var(--border-soft);
    transition:
      border-color var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .experiment::after {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  @media (hover: hover) {
    .experiment:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
    }

    .experiment:hover::after {
      opacity: 0.72;
      transform: scaleX(1);
    }
  }

  .experiment:focus-within {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .experiment:focus-within::after {
    opacity: 0.72;
    transform: scaleX(1);
  }

  .experiment-signal {
    position: relative;
    align-self: start;
    width: 4.6rem;
    aspect-ratio: 1;
    margin-top: 0.1rem;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    background:
      conic-gradient(from 0deg, transparent 0 22deg, var(--accent-soft) 22deg 28deg, transparent 28deg),
      radial-gradient(circle at center, transparent 0 42%, var(--border-soft) 43% 44%, transparent 45%);
    transition:
      border-color var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .experiment-signal::before,
  .experiment-signal::after,
  .experiment-signal span {
    position: absolute;
    border-radius: 50%;
    content: "";
  }

  .experiment-signal::before {
    inset: 22%;
    border: 1px dashed var(--border-soft);
  }

  .experiment-signal::after {
    top: 50%;
    left: 50%;
    width: 0.35rem;
    aspect-ratio: 1;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }

  .experiment-signal span {
    top: 0.72rem;
    right: 0.58rem;
    width: 0.42rem;
    aspect-ratio: 1;
    border: 1px solid var(--accent);
    background: var(--bg-1);
  }

  @media (hover: hover) {
    .experiment:hover .experiment-signal {
      border-color: var(--accent);
      transform: rotate(18deg);
    }
  }

  .experiment:focus-within .experiment-signal {
    border-color: var(--accent);
    transform: rotate(18deg);
  }

  .experiment-kicker {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .experiment-index {
    color: var(--accent);
  }

  .experiment-main {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .experiment-title {
    width: fit-content;
    text-decoration: none;
  }

  .experiment-main strong {
    font-size: 2.15rem;
    font-weight: 550;
    letter-spacing: 0;
    line-height: 1.1;
    color: var(--fg-0);
  }

  .experiment-main p {
    color: var(--fg-1);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 52ch;
  }

  .experiment-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg-2);
  }

  .experiment-links a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    text-decoration: none;
  }

  .experiment-links span {
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .experiment-links a:hover span,
  .experiment-links a:focus-visible span {
    transform: translate(2px, -1px);
  }

  @media (max-width: 900px) {
    .hero h1 {
      font-size: 4.6rem;
    }

    .hero-orbit {
      right: -13rem;
    }
  }

  @media (max-width: 720px) {
    .hero h1 {
      font-size: 3.3rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .hero-orbit {
      top: -6rem;
      right: -15rem;
      width: 24rem;
    }

    .experiment {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .experiment-signal {
      width: 3.5rem;
    }

    .experiment-main strong {
      font-size: 1.75rem;
    }
  }
</style>
