---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const projectSlug = (id: string) => id.replace(/\.mdx?$/, "");
---

<SiteLayout title="Home">
  <div class="hero">
    <h1>
      <span class="hero-line">Sol</span>
      <span class="hero-line">Nicol</span>
    </h1>
    <p class="tagline">Visual experiments in design and code.</p>
  </div>

  <h3 id="experiments">Experiments</h3>

  <div class="experiment-list">
    {projects.map((project, i) => (
      <div class="experiment">
        <span class="experiment-index">{String(i + 1).padStart(2, "0")}</span>
        <div class="experiment-main">
          <strong>{project.data.label}</strong>
          <p>{project.data.thesis}</p>
          <div class="experiment-links">
            {project.data.liveUrl && <a href={project.data.liveUrl}>Enter</a>}
            <a href={`/projects/${projectSlug(project.id)}/`}>Read</a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h3 id="contact">Contact</h3>

  <ul class="links">
    <li><a href="mailto:sol@solnicol.com">sol@solnicol.com</a></li>
    <li><a href="https://www.linkedin.com/in/solnicol/">LinkedIn</a></li>
    <li><a href="https://github.com/solnicol">GitHub</a></li>
  </ul>
</SiteLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 2.25rem;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.2rem, 11vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    line-height: 0.92;
    margin-bottom: 1.5rem;
  }

  .tagline {
    font-size: clamp(1.2rem, 3.6vw, 1.55rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg-1);
    max-width: 60ch;
  }

  .experiment {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2.25rem 0 2.5rem;
  }

  .experiment-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .experiment-main {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .experiment-main strong {
    font-size: clamp(1.65rem, 4.2vw, 2.3rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--fg-0);
  }

  .experiment-main p {
    color: var(--fg-1);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 52ch;
  }

  .experiment-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--fg-2);
  }
</style>
