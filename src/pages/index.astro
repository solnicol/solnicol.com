---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);
const projectSlug = (id: string) => id.replace(/\.mdx?$/, "");
---

<SiteLayout title="Home">
  <div class="hero">
    <h1 aria-label="Sol Nicol">
        <span class="hero-line" aria-hidden="true">
          <span>S</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
        </span>
        <span class="hero-line" aria-hidden="true">
          <span>NIC</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
        </span>
    </h1>
    <p class="tagline">Making structure visible</p>
  </div>

  <h2 class="section-label" id="studies">Studies</h2>

  <div class="experiment-list">
    {projects.map((project) => (
      <div class="experiment">
        <div class="experiment-main">
          <div class="experiment-kicker">
            <span class="experiment-concepts">{project.data.concepts.join(" / ")}</span>
          </div>
          <a class="experiment-title" href={`/projects/${projectSlug(project.id)}/`}>
            <strong>{project.data.title}</strong>
          </a>
          <p>{project.data.thesis}</p>
          <div class="experiment-links">
            <a href={`/projects/${projectSlug(project.id)}/`}>View study <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h2 class="section-label" id="contact">Contact</h2>

  <ul class="links">
    <li><a href="mailto:sol@solnicol.com">sol@solnicol.com</a></li>
    <li><a href="https://www.linkedin.com/in/solnicol/">LinkedIn</a></li>
    <li><a href="https://x.com/SolNicol_">X</a></li>
  </ul>
</SiteLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--border-soft);
    border-left: 1px solid var(--border-soft);
    padding-bottom: 1.6rem;
    padding-left: clamp(1rem, 2vw, 1.35rem);
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    top: 0;
    left: -0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
    content: "";
    opacity: 0.78;
  }

  .hero::after {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1.35rem;
    background-image: linear-gradient(90deg, var(--border-strong), transparent 62%);
    content: "";
    opacity: 0.72;
    transform: scaleX(0.42);
    transform-origin: left;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: 6.2rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 0.92;
    margin-bottom: 1.25rem;
  }

  .hero-line {
    display: inline-flex;
    align-items: baseline;
  }

  .tagline {
    font-size: 1.42rem;
    line-height: 1.45;
    color: var(--fg-1);
    max-width: 60ch;
  }

  .experiment-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .experiment {
    min-width: 0;
  }

  .experiment-kicker {
    display: block;
    min-height: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .experiment-concepts {
    color: var(--fg-3);
    letter-spacing: 0.18em;
  }

  .experiment-main {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    width: 100%;
  }

  .experiment-title {
    display: block;
    text-decoration: none;
  }

  .experiment-title:hover strong,
  .experiment-title:focus-visible strong {
    color: var(--fg-1);
  }

  .experiment-main strong {
    font-size: 2.15rem;
    font-weight: 550;
    letter-spacing: 0;
    line-height: 1.1;
    color: var(--fg-0);
  }

  .experiment-main p {
    color: var(--fg-1);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 52ch;
  }

  .experiment-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-1);
  }

  .experiment-links a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    width: fit-content;
    color: var(--fg-2);
    text-decoration: none;
  }

  .experiment-links a:hover,
  .experiment-links a:focus-visible {
    color: var(--fg-0);
  }

  .experiment-links span {
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .experiment-links a:hover span,
  .experiment-links a:focus-visible span {
    transform: translate(2px, -1px);
  }

  @media (max-width: 900px) {
    .hero h1 {
      font-size: 4.6rem;
    }

    .experiment-list {
      gap: 2.5rem;
    }
  }

  @media (max-width: 720px) {
    .hero h1 {
      font-size: 3.3rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .experiment-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .experiment-main strong {
      font-size: 1.75rem;
    }

    .experiment-kicker {
      min-height: 0;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-name,
    .glyph-code {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }

</style>

<style is:global>
  .hero .glyph-swap {
    display: inline-grid;
    min-width: 1.19em;
    color: inherit;
    perspective: 0.9em;
  }

  .hero .glyph-name,
  .hero .glyph-code {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    transform-origin: center 58%;
    transition:
      opacity 340ms var(--ease-out),
      transform 340ms var(--ease-out);
  }

  .hero .glyph-name {
    animation: revealName 1.6s var(--ease-out) 800ms backwards;
  }

  .hero .glyph-code {
    color: var(--signal);
    background: linear-gradient(
      135deg,
      oklch(55% 0.12 72) 0%,
      oklch(75% 0.14 82) 25%,
      oklch(92% 0.08 88) 50%,
      oklch(70% 0.15 80) 75%,
      oklch(48% 0.13 70) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 180% 180%;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: rotateX(58deg) translateY(0.025em);
    animation: revealCode 1.6s var(--ease-out) 800ms backwards;
  }

  @keyframes revealName {
    0%, 100% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
    20%, 60% {
      opacity: 0;
      transform: rotateX(-58deg) translateY(-0.025em);
    }
    80% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
  }

  @keyframes revealCode {
    0%, 100% {
      opacity: 0;
      transform: rotateX(58deg) translateY(0.025em);
      background-position: 0% 50%;
    }
    20% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
      background-position: 10% 50%;
    }
    60% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
      background-position: 90% 50%;
    }
    80% {
      opacity: 0;
      transform: rotateX(58deg) translateY(0.025em);
      background-position: 100% 50%;
    }
  }

  @media (hover: hover) {
    .hero h1:hover .glyph-name {
      opacity: 0;
      transform: rotateX(-58deg) translateY(-0.025em);
    }

    .hero h1:hover .glyph-code {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
  }
</style>
