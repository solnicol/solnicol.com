---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) =>
  b.data.year === a.data.year
    ? a.data.title.localeCompare(b.data.title)
    : b.data.year - a.data.year
);
const projectSlug = (id: string) => id.replace(/\.mdx?$/, "");
---

<SiteLayout
  title="Home"
  description="Concept-led experiments by Sol Nicol, making structure visible through design and code"
>
  <header class="hero">
    <h1 aria-label="Sol Nicol">
      <span class="hero-line" aria-hidden="true">
        <span>S</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
      </span>
      <span class="hero-line" aria-hidden="true">
        <span>NIC</span><span class="glyph-swap"><span class="glyph-name">OL</span><span class="glyph-code">01</span></span>
      </span>
    </h1>
    <p class="tagline">Making structure visible</p>
  </header>

  <section class="studies" id="studies" aria-labelledby="studies-title">
    <header class="studies-header">
      <h2 id="studies-title">Selected studies</h2>
    </header>
    <div class="study-list">
      {projects.map((project) => (
        <article class="study">
          <a class="study-link" href={`/projects/${projectSlug(project.id)}/`}>
            <div class="study-copy">
              <p class="study-concepts">{project.data.concepts.join(" / ")}</p>
              <h3>{project.data.title}</h3>
              <p class="study-thesis">{project.data.thesis}</p>
              <span class="study-action">
                View study <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <h2 class="visually-hidden" id="contact-title">Contact</h2>
    <p class="contact-intro">For projects, collaborations or questions</p>
    <a class="contact-email" href="mailto:sol@solnicol.com">sol@solnicol.com</a>
  </section>
</SiteLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(24rem, 52vh, 34rem);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border-bottom: 1px solid var(--border-soft);
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    top: clamp(2.5rem, 6vw, 4rem);
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
    content: "";
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    font-size: clamp(4.5rem, 10vw, 7.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .hero-line {
    display: inline-flex;
    align-items: baseline;
  }

  .tagline {
    max-width: 38ch;
    color: var(--fg-0);
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    line-height: 1.3;
  }

  .studies {
    scroll-margin-top: 6rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .studies-header {
    border-top: 1px solid var(--border-soft);
    padding-top: 1.15rem;
  }

  .studies-header h2 {
    color: var(--fg-0);
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .study-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .study {
    min-width: 0;
  }

  .study-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .study-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.1rem;
  }

  .study-concepts {
    min-height: 2.2rem;
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .study h3 {
    margin-top: 0.4rem;
    color: var(--fg-0);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .study-thesis {
    max-width: 42ch;
    margin-top: 0.8rem;
    color: var(--fg-1);
    font-size: 1rem;
    line-height: 1.55;
  }

  .study-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.2rem;
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .study-action span {
    color: var(--fg-0);
    transition: transform var(--duration-med) var(--ease-out);
  }

  .study-link:hover .study-action span,
  .study-link:focus-visible .study-action span {
    transform: translateX(3px);
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: clamp(4.5rem, 10vw, 7rem);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(1rem, 3vw, 2rem);
    border-top: 1px solid var(--border-strong);
    scroll-margin-top: 6rem;
  }

  .contact-intro {
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-email {
    width: fit-content;
    color: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 450;
    letter-spacing: 0.02em;
    line-height: 1.5;
    text-decoration: none;
  }

  @media (max-width: 780px) {
    .hero {
      min-height: clamp(28rem, 70svh, 36rem);
    }

    .study-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .study-concepts {
      min-height: 0;
    }

    .contact {
      align-items: start;
    }

  }

  @media (max-width: 480px) {
    .hero {
      min-height: 30rem;
      padding-right: 0;
      padding-left: 0;
    }

    .hero::before {
      display: none;
    }

    .hero h1 {
      font-size: clamp(3.8rem, 22vw, 5.3rem);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-name,
    .glyph-code,
    .study-action span {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<style is:global>
  .hero .glyph-swap {
    display: inline-grid;
    min-width: 1.19em;
    color: inherit;
    perspective: 0.9em;
  }

  .hero .glyph-name,
  .hero .glyph-code {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    transform-origin: center 58%;
    transition:
      opacity 340ms var(--ease-out),
      transform 340ms var(--ease-out);
  }

  .hero .glyph-name {
    animation: revealName 1.6s var(--ease-out) 800ms backwards;
  }

  .hero .glyph-code {
    color: var(--signal);
    background: linear-gradient(
      135deg,
      oklch(55% 0.12 72) 0%,
      oklch(75% 0.14 82) 25%,
      oklch(92% 0.08 88) 50%,
      oklch(70% 0.15 80) 75%,
      oklch(48% 0.13 70) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 180% 180%;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: rotateX(58deg) translateY(0.025em);
    animation: revealCode 1.6s var(--ease-out) 800ms backwards;
  }

  @keyframes revealName {
    0%, 100% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
    20%, 60% {
      opacity: 0;
      transform: rotateX(-58deg) translateY(-0.025em);
    }
    80% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
  }

  @keyframes revealCode {
    0%, 100% {
      opacity: 0;
      transform: rotateX(58deg) translateY(0.025em);
      background-position: 0% 50%;
    }
    20% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
      background-position: 10% 50%;
    }
    60% {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
      background-position: 90% 50%;
    }
    80% {
      opacity: 0;
      transform: rotateX(58deg) translateY(0.025em);
      background-position: 100% 50%;
    }
  }

  @media (hover: hover) {
    .hero h1:hover .glyph-name {
      opacity: 0;
      transform: rotateX(-58deg) translateY(-0.025em);
    }

    .hero h1:hover .glyph-code {
      opacity: 1;
      transform: rotateX(0deg) translateY(0);
    }
  }
</style>
