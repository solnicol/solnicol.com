---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import TemperamentClock from "../../components/temperament-clock/TemperamentClock.jsx";
import FlatWhiteExperiment from "../../components/flat-white/FlatWhiteExperiment.tsx";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.mdx?$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// A project opts into a live figure via its `embed` frontmatter key; the
// hero's CTAs then defer to the figure's title block. Client-hydrated
// components must be referenced by their static import name (Astro can't
// hydrate one chosen from a lookup), so each embed is matched by key in the
// figure below — a new interactive model is a one-line addition there.
const embed = project.data.embed;
const hasEmbed = Boolean(embed);
---

<SiteLayout title={project.data.title} description={project.data.ogDescription ?? project.data.thesis}>
  <article class="project-page">
    <header class="project-hero">
      <p class="project-label">{project.data.label}</p>
      <h1>{project.data.title}</h1>
      <p class="project-thesis">{project.data.thesis}</p>
      {!hasEmbed && (project.data.liveUrl || project.data.repoUrl) && (
        <div class="project-links" aria-label="Project links">
          {project.data.liveUrl && <a href={project.data.liveUrl}>Enter</a>}
          {project.data.repoUrl && <a href={project.data.repoUrl}>Source</a>}
        </div>
      )}
    </header>

    {hasEmbed && (
      <figure class="project-embed">
        {embed === "temperament-clock" && <TemperamentClock embedded client:only="react" />}
        {embed === "flat-white" && <FlatWhiteExperiment embedded client:only="react" />}
        <noscript>
          <p style="padding: 1.25rem 0.75rem; color: var(--fg-2); font-size: 0.9rem; line-height: 1.6;">
            This figure is an interactive audio model and needs JavaScript. The notes below explain it,
            or open it <a href={project.data.liveUrl}>fullscreen</a>.
          </p>
        </noscript>
        <figcaption class="project-embed-label">
          <span class="project-embed-id">{project.data.embedCaption}</span>
          <span class="project-embed-actions">
            {project.data.liveUrl && (
              <a href={project.data.liveUrl}>Fullscreen <span class="arrow" aria-hidden="true">⤢</span></a>
            )}
            {project.data.repoUrl && (
              <a href={project.data.repoUrl}>Source <span class="arrow" aria-hidden="true">↗</span></a>
            )}
          </span>
        </figcaption>
      </figure>
    )}

    <div class="project-body">
      <Content />
    </div>
  </article>
</SiteLayout>
