---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sol Nicol's digital home, exploring tech, systems, and timeless ideas.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://solnicol.com");
const pageTitle = title === "Home" ? "Sol Nicol" : `${title} | Sol Nicol`;
const ogImage = new URL("/og.jpg", Astro.site ?? "https://solnicol.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="surface">
      <header class="site-header" aria-label="Site header">
        <div class="wordmark-block">
          <a class="wordmark" href="/">Sol Nicol</a>
        </div>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/projects/">Projects</a>
          <a href="/notes/">Notes</a>
          <a href="/work/">Work</a>
          <a href="/now/">Now</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="metadata" aria-label="Site metadata">
        <div class="meta-grid">
          <div class="meta-pair">
            <span class="meta-label">Base</span>
            <span class="meta-value">Edinburgh, Scotland</span>
          </div>
          <div class="meta-pair">
            <span class="meta-label">Cycle</span>
            <span class="meta-value">Jul 2026</span>
          </div>
          <div class="meta-pair">
            <span class="meta-label">Status</span>
            <span class="meta-value">Active build mode</span>
          </div>
          <div class="meta-pair">
            <span class="meta-label">Contact</span>
            <a class="meta-value" href="mailto:sol@solnicol.com">sol@solnicol.com</a>
          </div>
        </div>
        <div class="micro-footer">
          <span>© 2026 Sol Nicol</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-0: #000;
    --bg-1: #0a0a0a;
    --bg-2: #111;
    --fg-0: #f5f5f5;
    --fg-1: #d4d4d4;
    --fg-2: #8a8a8a;
    --accent: #fff;
    --border-soft: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.16);
    --font-main: "Geist", sans-serif;
    --font-mono: "Geist Mono", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    background: radial-gradient(circle at top, rgba(255, 255, 255, 0.05), transparent 40%), linear-gradient(130deg, var(--bg-0), var(--bg-1) 45%, var(--bg-2));
    color: var(--fg-0);
    font-family: var(--font-main);
    font-feature-settings: "ss01" 1, "liga" 1;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.02) 1px, transparent 1px, transparent 32px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.015), rgba(255, 255, 255, 0.015) 1px, transparent 1px, transparent 48px);
    pointer-events: none;
    z-index: 0;
  }

  .surface {
    width: min(960px, calc(100vw - 3rem));
    background: linear-gradient(165deg, #040404, #0d0d0d 60%, #000);
    border: 1px solid var(--border-strong);
    padding: clamp(2rem, 5vw, 3.5rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.65);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: relative;
    isolation: isolate;
    z-index: 1;
  }

  .surface::after {
    content: "";
    position: absolute;
    inset: 1px;
    border: 1px solid var(--border-soft);
    pointer-events: none;
    opacity: 0.45;
  }

  a {
    color: inherit;
    text-decoration: none;
    letter-spacing: -0.015em;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    transition: color 0.25s ease;
  }

  a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
    opacity: 0.85;
  }

  a:hover::after {
    transform: scaleX(1);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.75rem;
    position: relative;
  }

  .site-header::before {
    content: "";
    position: absolute;
    top: -1.25rem;
    left: 0;
    width: 64px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .wordmark {
    font-size: clamp(2.1rem, 4vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    padding-bottom: 0.3rem;
  }

  .wordmark::after {
    display: none;
  }

  .site-nav {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .site-nav a {
    padding-bottom: 0.4rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .bio {
    font-size: clamp(1.2rem, 3.6vw, 1.55rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg-1);
    max-width: 60ch;
  }

  .bio strong {
    font-weight: 550;
    color: var(--accent);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
    display: inline-flex;
    gap: 0.5ch;
    align-items: center;
    margin-top: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 0.45rem;
  }

  .bio + h3 {
    margin-top: clamp(2.2rem, 4vw, 3rem);
  }

  .build-list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    border-top: 1px solid var(--border-soft);
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    gap: 0;
  }

  .build-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    width: 100%;
    padding: 0.85rem 0 1rem;
  }

  .build-item + .build-item {
    border-top: 1px solid var(--border-soft);
    padding-top: 1.1rem;
  }

  .build-item strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--fg-0);
    max-width: 60ch;
    line-height: 1.35;
  }

  .build-item p {
    color: var(--fg-2);
    font-size: 0.97rem;
    line-height: 1.45;
    max-width: 60ch;
  }

  ul.links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .project-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.65rem;
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .project-hero h1 {
    color: oklch(0.86 0.024 255 / 0.72);
    background: linear-gradient(
      120deg,
      oklch(0.86 0.024 255 / 0) 35%,
      oklch(0.91 0.19 310 / 0.92) 44%,
      oklch(0.94 0.17 190 / 0.98) 50%,
      oklch(0.92 0.18 78 / 0.94) 56%,
      oklch(0.86 0.024 255 / 0) 65%
    );
    background-clip: text;
    background-size: 220% 100%;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 10ch;
    animation: project-title-shine 5.5s linear infinite;
  }

  @keyframes project-title-shine {
    0% {
      background-position: 120% 0;
    }

    100% {
      background-position: -120% 0;
    }
  }

  .project-thesis {
    color: var(--fg-1);
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 46ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.5rem;
    font-family: var(--font-mono);
  }

  .project-facts div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-facts dt {
    color: var(--fg-2);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .project-facts dd {
    color: var(--fg-1);
    font-size: 0.9rem;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-body p {
    color: var(--fg-1);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .project-body strong {
    color: var(--fg-0);
    font-weight: 550;
  }

  .metadata {
    border-top: 1px solid var(--border-strong);
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--font-mono);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem 1.5rem;
  }

  .meta-pair {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-label {
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .meta-value {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--fg-1);
  }

  .micro-footer {
    border-top: 1px solid var(--border-soft);
    padding-top: 0.85rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  ::selection {
    background: var(--accent);
    color: #050505;
  }

  @media (max-width: 720px) {
    body {
      padding: 1.25rem;
    }

    .surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .micro-footer {
      flex-direction: column;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero h1 {
      animation: none;
      background-position: 50% 0;
    }
  }
</style>
