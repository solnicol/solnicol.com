---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  legacyVisual?: boolean;
}

const {
  title,
  description = "Making structure visible",
  ogImage: ogImagePath = "/og.jpg",
  structuredData,
  legacyVisual = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://solnicol.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const pageTitle = title === "Home"
  ? "Sol Nicol | Making structure visible"
  : `${title} | Sol Nicol`;
const ogImage = new URL(ogImagePath, siteUrl);
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Sol Nicol",
    url: siteUrl.toString(),
    sameAs: [
      "https://www.linkedin.com/in/solnicol/",
      "https://x.com/SolNicol_",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Sol Nicol",
    url: siteUrl.toString(),
    description: "Concept-led experiments in design and code",
  },
];
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#002fa7" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify([...baseStructuredData, ...pageStructuredData])} />
  </head>
  <body class:list={{ "legacy-visual": legacyVisual }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={{ surface: true, "legacy-surface": legacyVisual }}>
      <header class="site-header" aria-label="Site header">
        <a class="site-mark" href="/">
          <span class="mark-sigil" style="display: grid; gap: 0.05rem;">
            <span>&gt;_S01</span>
            <span>NIC01</span>
          </span>
          <span class="visually-hidden">Sol Nicol home</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/#studies">Studies</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>

      <main class="content" id="main-content">
        <slot />
      </main>

    </div>
  </body>
</html>

<style is:global>
  :root {
    /*
      Palette: one ground, three inks, one signal.

      Ground - International Klein Blue (#002FA7), hue 263. The sheet.
      Inks   - white at three lightness steps. The drawing: structure,
               wayfinding, prose. All borders are ink at reduced alpha.
      Signal - gold leaf, hue 97: the opponent of hue 263 on the
               blue-yellow axis of OKLab, and Klein's own pairing
               (IKB / Monogold). Matched to the leaf itself: high
               lightness, LOW chroma - real gold is pale, its richness
               is sheen, not pigment. Reserved for what is LIVE: sound,
               play, the active thing. Never for wayfinding, never for
               structure. If in doubt, use ink. Contrast on ground
               ≈ 5.7:1 (AA at any size). At display sizes the signal
               may render as leaf - a gradient of the same metal (see
               small and functional text stays flat.
    */
    --ikb: oklch(0.3785 0.1954 263.23);
    --bg-0: var(--ikb);
    --bg-1: var(--ikb);
    --bg-2: oklch(0.43 0.18 263.23);
    --fg-0: oklch(0.985 0.003 260);
    --fg-1: oklch(0.9 0.01 260);
    --fg-2: oklch(0.76 0.018 260);
    --fg-3: var(--fg-2);
    --signal: oklch(0.8 0.08 97);
    --accent: oklch(0.985 0.003 260);
    --accent-soft: oklch(1 0 0 / 0.12);
    --border-soft: oklch(1 0 0 / 0.14);
    --border-strong: oklch(1 0 0 / 0.36);
    --shadow-soft: oklch(0 0 0 / 0.24);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-snap: cubic-bezier(0.2, 0.8, 0.2, 1);
    --duration-fast: 160ms;
    --duration-med: 220ms;
    --font-main: "Geist Variable", sans-serif;
    --font-mono: "Geist Mono Variable", monospace;
    --space-1: 0.5rem;
    --space-2: 0.75rem;
    --space-3: 1rem;
    --space-4: 1.5rem;
    --space-5: 2rem;
    --space-6: 3rem;
    --space-7: 4.5rem;
    --space-8: 7rem;
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    position: relative;
    min-height: 100dvh;
    background: var(--bg-1);
    color: var(--fg-0);
    font-family: var(--font-main);
    font-feature-settings: "ss01" 1, "liga" 1;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
    padding: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(oklch(1 0 0 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.035) 1px, transparent 1px),
      linear-gradient(oklch(1 0 0 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.06) 1px, transparent 1px);
    background-position: center;
    background-size:
      1.5rem 1.5rem,
      1.5rem 1.5rem,
      9rem 9rem,
      9rem 9rem;
    content: "";
    pointer-events: none;
  }

  .surface {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100vw - 2rem));
    padding: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .surface::before,
  .surface::after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-soft);
    content: "";
    opacity: 0.72;
    pointer-events: none;
  }

  .surface::before {
    left: 0;
  }

  .surface::after {
    right: 0;
  }

  a {
    color: inherit;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.3rem;
    text-decoration-color: transparent;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    padding: 0.65rem 0.85rem;
    background: var(--fg-0);
    color: var(--bg-0);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1.5rem;
    padding-bottom: var(--space-4);
  }

  @media (min-width: 721px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 5;
      padding-top: var(--space-3);
      background: var(--bg-0);
    }
  }

  .site-header::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--border-soft);
    content: "";
  }

  .site-mark {
    position: relative;
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1.15;
    color: var(--fg-2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-mark:hover {
    color: var(--fg-0);
    text-decoration: none;
  }

  .mark-sigil {
    display: grid;
    gap: 0.05rem;
  }

  .site-nav {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .site-nav a {
    position: relative;
    color: var(--fg-2);
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--fg-0);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  body.legacy-visual {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  body.legacy-visual .legacy-surface {
    width: min(960px, calc(100vw - 3rem));
    padding: clamp(1rem, 3vw, 2rem);
    gap: 2rem;
  }

  body.legacy-visual .site-header {
    position: relative;
    flex-wrap: wrap;
    min-height: 0;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  body.legacy-visual .site-nav {
    flex-wrap: wrap;
  }

  body.legacy-visual .content {
    gap: 1.8rem;
  }

  @media (min-width: 721px) {
    body.legacy-visual .site-header {
      position: relative;
      top: auto;
      z-index: auto;
      padding-top: 0;
      background: transparent;
    }
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 450;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: 0.45rem;
    scroll-margin-top: 2rem;
  }

  ul.links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--fg-1);
  }

  ul.links a {
    position: relative;
    display: inline-flex;
    color: var(--fg-2);
    text-decoration: none;
  }

  ul.links a:hover,
  ul.links a:focus-visible {
    color: var(--fg-0);
  }

  .project-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.65rem;
  }

  .project-hero h1 {
    color: var(--fg-0);
    font-size: 4.1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 12ch;
  }

  .project-thesis {
    color: var(--fg-1);
    font-size: 1.45rem;
    line-height: 1.35;
    letter-spacing: 0;
    max-width: 46ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.45rem;
  }

  .project-links a {
    border: 1px solid var(--border-strong);
    color: var(--fg-0);
    padding: 0.6rem 0.9rem;
    text-decoration: none;
  }

  .project-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .project-embed {
    position: relative;
    border: 1px solid var(--border-soft);
    margin: 0;
    padding-top: 1.5rem;
  }

  .project-embed::before {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
    content: "";
    opacity: 0.78;
  }

  .project-embed-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding: 0.35rem 0.75rem;
    border-top: 1px solid var(--border-soft);
  }

  .project-embed-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-right: -0.1rem;
  }

  .project-embed-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0;
    color: var(--fg-2);
    text-decoration: none;
  }

  .project-embed-actions a:hover,
  .project-embed-actions a:focus-visible {
    color: var(--fg-0);
  }

  .project-embed-actions .arrow {
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .project-embed-actions a:hover .arrow,
  .project-embed-actions a:focus-visible .arrow {
    transform: translate(1px, -1px);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-body p {
    color: var(--fg-1);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .project-body h2 {
    color: var(--fg-0);
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.3;
    margin-top: 1.2rem;
    max-width: 64ch;
  }

  .project-body strong {
    color: var(--fg-0);
    font-weight: 550;
  }

  .project-body a {
    color: var(--fg-0);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-body a:hover {
    text-decoration-color: var(--fg-0);
  }

  /* Selection is live - the one place gold touches prose. */
  ::selection {
    background: var(--signal);
    color: var(--bg-0);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }

  @media (max-width: 900px) {
    .project-hero h1 {
      font-size: 3.2rem;
    }

    .project-thesis {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 720px) {
    body {
      padding: 1.25rem;
    }

    .surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    body.legacy-visual .legacy-surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    body.legacy-visual .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    body.legacy-visual .site-nav {
      justify-content: flex-start;
    }

    .site-nav a {
      padding: 0.6rem 0.75rem;
    }

    ul.links a {
      padding: 0.65rem 0.85rem;
    }

    .project-links a {
      padding: 0.75rem 1rem;
    }

    .project-hero h1 {
      font-size: 2.35rem;
    }
  }
</style>
