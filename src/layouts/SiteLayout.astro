---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sol Nicol's digital home, exploring tech, systems, and timeless ideas.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://solnicol.com");
const pageTitle = title === "Home" ? "Sol Nicol" : `${title} | Sol Nicol`;
const ogImage = new URL("/og.jpg", Astro.site ?? "https://solnicol.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#002fa7" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="surface">
      <header class="site-header" aria-label="Site header">
        <a class="site-mark" href="/" aria-label="Sol Nicol home">
          <span class="mark-sigil" aria-hidden="true">
            <span>&gt;_S01</span>
            <span>NIC01</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/#experiments">Experiments</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="metadata">
        <dl class="meta-grid" aria-label="Site metadata">
          <div>
            <dt>Drawn By</dt>
            <dd>Sol Nicol</dd>
          </div>
          <div>
            <dt>Sheet</dt>
            <dd>S01 / NIC01</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>Edinburgh</dd>
          </div>
          <div>
            <dt>Revision</dt>
            <dd>2026</dd>
          </div>
        </dl>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ikb: oklch(0.3785 0.1954 263.23);
    --bg-0: var(--ikb);
    --bg-1: var(--ikb);
    --bg-2: oklch(0.43 0.18 263.23);
    --fg-0: oklch(0.985 0.003 260);
    --fg-1: oklch(0.9 0.01 260);
    --fg-2: oklch(0.76 0.018 260);
    --fg-3: oklch(0.74 0.02 260);
    --accent: oklch(0.985 0.003 260);
    --accent-soft: oklch(1 0 0 / 0.12);
    --border-soft: oklch(1 0 0 / 0.14);
    --border-strong: oklch(1 0 0 / 0.36);
    --shadow-soft: oklch(0 0 0 / 0.24);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-snap: cubic-bezier(0.2, 0.8, 0.2, 1);
    --duration-fast: 160ms;
    --duration-med: 220ms;
    --font-main: "Geist Variable", sans-serif;
    --font-mono: "Geist Mono Variable", monospace;
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    position: relative;
    min-height: 100vh;
    background: var(--bg-1);
    color: var(--fg-0);
    font-family: var(--font-main);
    font-feature-settings: "ss01" 1, "liga" 1;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(oklch(1 0 0 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.045) 1px, transparent 1px),
      linear-gradient(oklch(1 0 0 / 0.075) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.075) 1px, transparent 1px);
    background-position: center;
    background-size:
      1.5rem 1.5rem,
      1.5rem 1.5rem,
      9rem 9rem,
      9rem 9rem;
    content: "";
    pointer-events: none;
  }

  .surface {
    position: relative;
    z-index: 1;
    width: min(960px, calc(100vw - 3rem));
    padding: clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .surface::before,
  .surface::after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-soft);
    content: "";
    opacity: 0.72;
    pointer-events: none;
  }

  .surface::before {
    left: 0;
  }

  .surface::after {
    right: 0;
  }

  a {
    color: inherit;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.35rem;
    text-decoration-color: transparent;
  }

  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .site-header::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--border-soft);
    content: "";
  }

  .site-mark {
    position: relative;
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1.15;
    color: var(--fg-2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-mark:hover {
    color: var(--fg-0);
    text-decoration: none;
  }

  .mark-sigil {
    display: grid;
    gap: 0.05rem;
  }

  .site-nav {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .site-nav a {
    position: relative;
    border: 1px solid var(--border-soft);
    padding: 0.34rem 0.52rem;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 450;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: 0.45rem;
    scroll-margin-top: 2rem;
  }

  ul.links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--fg-1);
  }

  ul.links a {
    position: relative;
    display: inline-flex;
    border: 1px solid var(--border-strong);
    padding: 0.46rem 0.66rem;
    text-decoration: none;
  }

  ul.links a:hover,
  ul.links a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .project-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.65rem;
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .project-hero h1 {
    color: var(--fg-0);
    font-size: 4.1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 12ch;
  }

  .project-thesis {
    color: var(--fg-1);
    font-size: 1.45rem;
    line-height: 1.35;
    letter-spacing: 0;
    max-width: 46ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.45rem;
  }

  .project-links a {
    border: 1px solid var(--border-strong);
    color: var(--fg-0);
    padding: 0.6rem 0.9rem;
    text-decoration: none;
  }

  .project-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-body p {
    color: var(--fg-1);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .project-body h2 {
    color: var(--fg-0);
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.3;
    margin-top: 1.2rem;
    max-width: 64ch;
  }

  .project-body strong {
    color: var(--fg-0);
    font-weight: 550;
  }

  .project-body a {
    color: var(--fg-0);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-body a:hover {
    text-decoration-color: var(--fg-0);
  }

  .metadata {
    border-top: 1px solid var(--border-soft);
    padding-top: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-2);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-left: 1px solid var(--border-soft);
    list-style: none;
  }

  .meta-grid div {
    min-width: 0;
    border-right: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    padding: 0.62rem 0.72rem 0.68rem;
  }

  .meta-grid dt {
    color: var(--fg-3);
    font-size: 0.64rem;
    letter-spacing: 0.24em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .meta-grid dd {
    color: var(--fg-1);
    font-size: 0.72rem;
    line-height: 1.35;
    margin-top: 0.25rem;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-0);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }

  @media (max-width: 900px) {
    .project-hero h1 {
      font-size: 3.2rem;
    }

    .project-thesis {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 720px) {
    body {
      padding: 1.25rem;
    }

    .surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .site-nav a {
      padding: 0.6rem 0.75rem;
    }

    ul.links a {
      padding: 0.65rem 0.85rem;
    }

    .project-links a {
      padding: 0.75rem 1rem;
    }

    .meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-hero h1 {
      font-size: 2.35rem;
    }
  }
</style>
