---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sol Nicol's digital home, exploring tech, systems, and timeless ideas.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://solnicol.com");
const pageTitle = title === "Home" ? "Sol Nicol" : `${title} | Sol Nicol`;
const ogImage = new URL("/og.jpg", Astro.site ?? "https://solnicol.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="surface">
      <header class="site-header" aria-label="Site header">
        <a class="site-mark" href="/" aria-label="Sol Nicol home">
          <span class="mark-sigil" aria-hidden="true">
            <span class="mark-line">
              <span class="mark-prompt">&gt;<span class="mark-cursor">_</span></span>
              <span class="mark-stem">S</span>
              <span class="mark-binary"><span class="mark-zero">0</span><span>1</span></span>
            </span>
            <span class="mark-line">
              <span class="mark-name">NIC</span>
              <span class="mark-binary"><span class="mark-zero">0</span><span>1</span></span>
            </span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/#experiments">Experiments</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="metadata">
        <div class="meta-info">
          <span>© 2026 Sol Nicol</span>
          <span>Edinburgh</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-0: oklch(0.055 0.005 260);
    --bg-1: oklch(0.085 0.006 260);
    --bg-2: oklch(0.13 0.008 260);
    --fg-0: oklch(0.965 0.004 260);
    --fg-1: oklch(0.84 0.006 260);
    --fg-2: oklch(0.62 0.011 260);
    --fg-3: oklch(0.42 0.012 260);
    --accent: oklch(0.76 0.145 164);
    --accent-soft: oklch(0.76 0.145 164 / 0.18);
    --border-soft: oklch(1 0 0 / 0.075);
    --border-strong: oklch(1 0 0 / 0.16);
    --shadow-soft: oklch(0 0 0 / 0.42);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-snap: cubic-bezier(0.2, 0.8, 0.2, 1);
    --duration-fast: 160ms;
    --duration-med: 220ms;
    --font-main: "Geist", sans-serif;
    --font-mono: "Geist Mono", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    background: var(--bg-1);
    color: var(--fg-0);
    font-family: var(--font-main);
    font-feature-settings: "ss01" 1, "liga" 1;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .surface {
    width: min(960px, calc(100vw - 3rem));
    padding: clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  a {
    color: inherit;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.35rem;
    text-decoration-color: transparent;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .site-mark {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    padding: 0.38rem 0.44rem;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    line-height: 1.15;
    color: var(--fg-2);
    text-decoration: none;
    transition:
      border-color var(--duration-med) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-med) var(--ease-out);
  }

  .site-mark::before,
  .site-mark::after {
    position: absolute;
    pointer-events: none;
    content: "";
    opacity: 0;
    transition:
      opacity var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .site-mark::before {
    inset: -1px;
    border: 1px solid var(--border-soft);
    background:
      linear-gradient(90deg, transparent, var(--accent-soft), transparent),
      repeating-linear-gradient(
        180deg,
        transparent 0 5px,
        oklch(1 0 0 / 0.045) 5px 6px
      );
    transform: scaleX(0.88);
    z-index: -1;
  }

  .site-mark::after {
    top: 0.2rem;
    right: -0.25rem;
    color: var(--accent);
    content: "01";
    font-size: 0.58rem;
    line-height: 1;
    transform: translateY(0.3rem);
  }

  .site-mark:hover {
    color: var(--fg-0);
    text-decoration: none;
  }

  .site-mark:hover::before,
  .site-mark:focus-visible::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-mark:hover::after,
  .site-mark:focus-visible::after {
    opacity: 0.72;
    transform: translateY(0);
  }

  .mark-sigil {
    position: relative;
    display: grid;
    gap: 0.05rem;
  }

  .mark-line {
    display: grid;
    grid-template-columns: 2ch 1ch 2ch;
    align-items: center;
  }

  .mark-line:last-child .mark-name {
    grid-column: 1 / 3;
  }

  .mark-prompt,
  .mark-stem,
  .mark-name,
  .mark-binary {
    display: inline-flex;
  }

  .mark-prompt {
    color: var(--fg-3);
  }

  .mark-cursor {
    color: var(--fg-2);
  }

  .mark-binary {
    position: relative;
    justify-content: flex-end;
    color: var(--accent);
    text-shadow: 0 0 0 transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-shadow var(--duration-med) var(--ease-out),
      transform var(--duration-med) var(--ease-out);
  }

  .mark-zero {
    position: relative;
  }

  .mark-zero::after {
    position: absolute;
    inset: 0;
    color: var(--fg-0);
    content: "O";
    opacity: 0;
    transform: translateY(0.2em);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .site-mark:hover .mark-binary,
  .site-mark:focus-visible .mark-binary {
    color: var(--fg-0);
    text-shadow: 0 0 16px var(--accent);
    transform: translateX(0.08rem);
  }

  .site-mark:hover .mark-zero::after,
  .site-mark:focus-visible .mark-zero::after {
    opacity: 0.42;
    transform: translateY(0);
  }

  .site-mark:hover .mark-cursor,
  .site-mark:focus-visible .mark-cursor {
    animation: cursor-wake 680ms steps(2, end) 1;
    color: var(--accent);
  }

  @keyframes cursor-wake {
    0%,
    100% {
      opacity: 1;
    }

    35%,
    65% {
      opacity: 0;
    }
  }

  .site-nav {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .site-nav a {
    position: relative;
    padding-bottom: 0.4rem;
    text-decoration: none;
  }

  .site-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    opacity: 0;
    transform: scaleX(0.25);
    transform-origin: left;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--fg-2);
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: 0.45rem;
  }

  ul.links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    font-size: 0.95rem;
    color: var(--fg-1);
  }

  .project-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.65rem;
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .project-hero h1 {
    color: var(--fg-0);
    font-size: 4.1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 10ch;
  }

  .project-thesis {
    color: var(--fg-1);
    font-size: 1.45rem;
    line-height: 1.35;
    letter-spacing: 0;
    max-width: 46ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.45rem;
  }

  .project-links a {
    border: 1px solid var(--border-strong);
    color: var(--fg-0);
    padding: 0.6rem 0.9rem;
    text-decoration: none;
  }

  .project-links a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.5rem;
    font-family: var(--font-mono);
  }

  .project-facts div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-facts dt {
    color: var(--fg-2);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .project-facts dd {
    color: var(--fg-1);
    font-size: 0.9rem;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-body p {
    color: var(--fg-1);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .project-body h2 {
    color: var(--fg-0);
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.3;
    margin-top: 1.2rem;
    max-width: 64ch;
  }

  .project-body strong {
    color: var(--fg-0);
    font-weight: 550;
  }

  .project-body a {
    color: var(--fg-0);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-body a:hover {
    text-decoration-color: var(--fg-0);
  }

  .metadata {
    border-top: 1px solid var(--border-soft);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-2);
  }

  .meta-info {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-0);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }

  @media (max-width: 900px) {
    .project-hero h1 {
      font-size: 3.2rem;
    }

    .project-thesis {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 720px) {
    body {
      padding: 1.25rem;
    }

    .surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .project-hero h1 {
      font-size: 2.35rem;
    }
  }
</style>
