---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sol Nicol's digital home, exploring tech, systems, and timeless ideas.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://solnicol.com");
const pageTitle = title === "Home" ? "Sol Nicol" : `${title} | Sol Nicol`;
const ogImage = new URL("/og.jpg", Astro.site ?? "https://solnicol.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="surface">
      <header class="site-header" aria-label="Site header">
        <a class="site-mark" href="/" aria-label="Sol Nicol home">
          <span>&gt;_S01</span>
          <span>NIC01</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/#experiments">Experiments</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="metadata">
        <div class="meta-info">
          <span>© 2026 Sol Nicol</span>
          <span>Edinburgh</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-0: #000;
    --bg-1: #0a0a0a;
    --bg-2: #111;
    --fg-0: #f5f5f5;
    --fg-1: #f5f5f5;
    --fg-2: #9c9c9c;
    --accent: #fff;
    --border-soft: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.16);
    --font-main: "Geist", sans-serif;
    --font-mono: "Geist Mono", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    background: var(--bg-1);
    color: var(--fg-0);
    font-family: var(--font-main);
    font-feature-settings: "ss01" 1, "liga" 1;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .surface {
    width: min(960px, calc(100vw - 3rem));
    padding: clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  a {
    color: inherit;
    text-decoration: none;
    letter-spacing: -0.015em;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .site-mark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    line-height: 1.15;
    color: rgba(245, 245, 245, 0.62);
  }

  .site-mark:hover {
    color: var(--fg-0);
    text-decoration: none;
  }

  .site-nav {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .site-nav a {
    padding-bottom: 0.4rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--fg-2);
    margin-top: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 0.45rem;
  }

  ul.links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    font-size: 0.95rem;
    color: var(--fg-1);
  }

  .project-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-hero {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.65rem;
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .project-hero h1 {
    color: var(--fg-0);
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 10ch;
  }

  .project-thesis {
    color: var(--fg-1);
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 46ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.45rem;
  }

  .project-links a {
    border: 1px solid var(--border-strong);
    color: var(--fg-0);
    padding: 0.6rem 0.9rem;
  }

  .project-links a:hover {
    text-decoration: none;
    border-color: var(--fg-2);
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 1.5rem;
    font-family: var(--font-mono);
  }

  .project-facts div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-facts dt {
    color: var(--fg-2);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .project-facts dd {
    color: var(--fg-1);
    font-size: 0.9rem;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-body p {
    color: var(--fg-1);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .project-body strong {
    color: var(--fg-0);
    font-weight: 550;
  }

  .project-body a {
    color: var(--fg-0);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-body a:hover {
    text-decoration-color: var(--fg-0);
  }

  .metadata {
    border-top: 1px solid var(--border-soft);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-2);
  }

  .meta-info {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  ::selection {
    background: var(--accent);
    color: #050505;
  }

  @media (max-width: 720px) {
    body {
      padding: 1.25rem;
    }

    .surface {
      width: 100%;
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }
  }
</style>
